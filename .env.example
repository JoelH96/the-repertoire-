# Copy to .env.local for local development. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Set in Vercel as a Sensitive variable.
ANTHROPIC_API_KEY=
# Server-only. YouTube Data API v3 key, for reading video descriptions. Without it,
# YouTube import falls back to scraping the watch page, which YouTube often blocks on Vercel.
YOUTUBE_API_KEY=
